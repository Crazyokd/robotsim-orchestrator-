<?xml version="1.0"?>
<sdf version="1.6">
  <world name="map_world">

    <!-- ═══ Scene ═══ -->
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0 0 0 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <!-- ═══ GUI(给人观察:全屏 3D + 鼠标视角 + 底部播放条;默认不显示右侧 EntityTree/ComponentInspector 面板) ═══ -->
    <gui fullscreen="true">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0 0 0</background_color>
        <camera_pose>0 -8 6 0 0.5 1.570796</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="GameModePlugin" name="Game Mode">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker Manager">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <title>Sensor Visualization</title>
          <property key="resizable" type="bool">true</property>
          <property key="width" type="double">260</property>
          <property key="height" type="double">220</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">true</property>
          <property key="z" type="double">3</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
      </plugin>
      <plugin filename="Shapes" name="Shapes">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">300</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>
      <plugin filename="Lights" name="Lights">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">250</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="CopyPaste" name="CopyPaste">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">100</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">160</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <use_event>true</use_event>
      </plugin>
    </gui>

    <!-- ═══ Physics ═══ -->
    <physics name="1ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ═══ Plugins ═══ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ═══ Lights ═══ -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0.0 0.0 50 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.4 -1.0</direction>
    </light>
    <light name="fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0.0 0.0 30 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.4 -0.8</direction>
    </light>

    <!-- ═══ Ground Plane ═══ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 32</size></plane>
          </geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>40 32</size></plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══ Origin reference ═══ -->
    <model name="origin_visual_axes">
      <static>true</static>
      <link name="x_axis">
        <pose>1.0 0.3 0.03 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2 0.08 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="x_axis_arrow_upper">
        <pose>1.9 0.42 0.035 0 0 -0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="x_axis_arrow_lower">
        <pose>1.9 0.18 0.035 0 0 0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis">
        <pose>0.0 1.0 0.035 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.08 2 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis_arrow_left">
        <pose>-0.12 1.9 0.04 0 0 0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis_arrow_right">
        <pose>0.12 2.1999999999999997 0.04 0 0 2.356194</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="origin_disc">
        <pose>0.0 0.0 0.05 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>0.22</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══ Narrow corridor arena ═══
         用途：两车"真的过不去"的互等（多车解锁 S1）。
         通道净宽 1.2 m：单车（0.79 x 0.48 车身）通过毫无问题，
         两车（0.96 m 车身宽 + 余量）在通道里不可能错身 —— 只能一方退到端部
         的待避区，另一方先行通过。端部各有一个 3.2 m 宽待避区。
    -->
    <model name="corridor_arena">
      <static>true</static>

      <!-- ═══ 窄通道（多车解锁测试场地）═══
           净宽 1.2 m 的车道是东西两端待避区之间的**唯一通路**：车道墙与两端待避区的围墙
           把场地南北两侧封死（此前车道墙是立在开阔场地里的两条独立墙，车从墙外就绕过去了）。
           定位特征：x∈[-1,0] 的 0.3 m 缓变错位（不是台阶，车道宽度不变）、x∈[4.6,5.8] 的墙凹口、
           两端待避区各放一个不对称地标。场地外墙保持原样，bundle 的 origin_offset_mm 不变。 -->

      <!-- 车道南墙：西半段 y=-0.7、东半段 y=-0.4（中间由缓变段连接） -->
      <link name="lane_south_west">
        <pose>-8.425 -0.7 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>14.85 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>14.85 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="lane_south_taper">
        <pose>-0.5 -0.55 0.8 0 0 0.291457</pose>
        <collision name="collision"><geometry><box><size>1.044 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>1.044 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="lane_south_east">
        <pose>5.95 -0.4 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>11.9 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>11.9 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <!-- 车道北墙：西半段 y=+0.7、东半段 y=+1.0；东半段留一个 0.6 m 深的凹口 -->
      <link name="lane_north_west">
        <pose>-6.55 0.7 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>11.1 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>11.1 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="lane_north_taper">
        <pose>-0.5 0.85 0.8 0 0 0.291457</pose>
        <collision name="collision"><geometry><box><size>1.044 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>1.044 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="lane_north_east_a">
        <pose>2.3 1 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.6 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>4.6 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="niche_back">
        <pose>5.2 1.7 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.2 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>1.2 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.48 0.58 0.70 1</ambient>
            <diffuse>0.48 0.58 0.70 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="niche_west_side">
        <pose>4.6 1.4 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 0.6 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.15 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.48 0.58 0.70 1</ambient>
            <diffuse>0.48 0.58 0.70 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="niche_east_side">
        <pose>5.8 1.4 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 0.6 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.15 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.48 0.58 0.70 1</ambient>
            <diffuse>0.48 0.58 0.70 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="lane_north_east_b">
        <pose>10.825 1 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.05 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>10.05 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <!-- 西端待避区：向车道北侧扩出 3.5 m（两台车可并排） -->
      <link name="west_bay_north">
        <pose>-13.875 3 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.95 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>3.95 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="west_bay_cap">
        <pose>-12 1.95 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 2.3 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.2 2.3 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
      <link name="west_bay_landmark">
        <pose>-14.5 2.2 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.6 0.6 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.6 0.6 1.6</size></box></geometry>
          <material>
            <ambient>0.55 0.62 0.72 1</ambient>
            <diffuse>0.55 0.62 0.72 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <!-- 东端待避区：向车道南侧扩出 3.8 m -->
      <link name="east_bay_south">
        <pose>13.875 -3 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.95 0.2 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>3.95 0.2 1.6</size></box></geometry>
          <material>
            <ambient>0.62 0.72 0.82 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
