<?xml version="1.0"?>
<sdf version="1.6">
  <world name="map_world">

    <!-- ═══ Scene ═══ -->
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0 0 0 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <!-- ═══ GUI(给人观察:全屏 3D + 鼠标视角 + 底部播放条;默认不显示右侧 EntityTree/ComponentInspector 面板) ═══ -->
    <gui fullscreen="true">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0 0 0</background_color>
        <camera_pose>0 -8 6 0 0.5 1.570796</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="GameModePlugin" name="Game Mode">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker Manager">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <title>Sensor Visualization</title>
          <property key="resizable" type="bool">true</property>
          <property key="width" type="double">260</property>
          <property key="height" type="double">220</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">true</property>
          <property key="z" type="double">3</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
      </plugin>
      <plugin filename="Shapes" name="Shapes">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">300</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>
      <plugin filename="Lights" name="Lights">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">250</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="CopyPaste" name="CopyPaste">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">100</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">160</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <use_event>true</use_event>
      </plugin>
    </gui>

    <!-- ═══ Physics ═══ -->
    <physics name="1ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ═══ Plugins ═══ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ═══ Lights ═══ -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.4 -1.0</direction>
    </light>
    <light name="fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.4 -0.8</direction>
    </light>

    <!-- ═══ Ground Plane ═══ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 32</size></plane>
          </geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>40 32</size></plane>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══ Origin reference ═══ -->
    <model name="origin_visual_axes">
      <static>true</static>
      <link name="x_axis">
        <pose>1 0 0.03 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2 0.08 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="x_axis_arrow_upper">
        <pose>1.9 0.12 0.035 0 0 -0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="x_axis_arrow_lower">
        <pose>1.9 -0.12 0.035 0 0 0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis">
        <pose>0 1 0.035 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.08 2 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis_arrow_left">
        <pose>-0.12 1.9 0.04 0 0 0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis_arrow_right">
        <pose>0.12 1.9 0.04 0 0 2.356194</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="origin_disc">
        <pose>0 0 0.05 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>0.22</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══ Local imported assets ═══ -->
    <include>
      <uri>model://black_pallet</uri>
      <name>black_pallet_1</name>
      <pose>4.0 2.0 0 0 0 0.35</pose>
    </include>

    <include>
      <uri>model://cage1</uri>
      <name>cage1_1</name>
      <pose>-4.5 3.0 0 0 0 -0.4</pose>
    </include>

    <!-- ═══ Navigation test arena ═══ -->
    <model name="navigation_test_arena">
      <static>true</static>

      <!-- Outer boundary: robot spawns at (0, 0), far from all walls. -->
      <link name="north_wall">
        <pose>0 12 1 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>32 0.3 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box><size>32 0.3 2</size></box>
          </geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="south_wall">
        <pose>0 -12 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>32 0.3 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>32 0.3 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="east_wall">
        <pose>16 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 24 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.3 24 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="west_wall">
        <pose>-16 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.3 24 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.3 24 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <!-- Asymmetric landmarks: distinct shapes make the 2D SLAM map easy to orient. -->
      <!-- North: T-shaped wall. -->
      <link name="north_t_cap">
        <pose>0 8.5 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>7 0.25 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>7 0.25 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <link name="north_t_stem">
        <pose>0 6.5 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.25 3.5 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.25 3.5 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <!-- East: L-shaped wall. -->
      <link name="east_l_vertical">
        <pose>10.5 0.5 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.25 5 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.25 5 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <link name="east_l_foot">
        <pose>12 -2 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.25 0.25 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>3.25 0.25 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <!-- West: U-shaped bay opening toward the center. -->
      <link name="west_u_back">
        <pose>-12 0 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.25 5.5 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.25 5.5 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <link name="west_u_upper_arm">
        <pose>-10.5 2.75 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.25 0.25 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>3.25 0.25 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <link name="west_u_lower_arm">
        <pose>-10.5 -2.75 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.25 0.25 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>3.25 0.25 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <!-- South: three isolated blocks. -->
      <link name="south_block_left">
        <pose>-5 -8 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.9 0.9 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.9 0.9 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <link name="south_block_middle">
        <pose>0 -8 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.4 0.9 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>1.4 0.9 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>

      <link name="south_block_right">
        <pose>5 -8 0.8 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.9 1.4 1.6</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.9 1.4 1.6</size></box></geometry>
          <material>
            <ambient>0.58 0.68 0.78 1</ambient>
            <diffuse>0.62 0.72 0.82 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
