<?xml version="1.0"?>
<sdf version="1.6">
  <world name="map_world">

    <!-- ═══ Scene ═══ -->
    <scene>
      <ambient>1 1 1 1</ambient>
      <background>0 0 0 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <!-- ═══ GUI(给人观察:全屏 3D + 鼠标视角 + 底部播放条;默认不显示右侧 EntityTree/ComponentInspector 面板) ═══ -->
    <gui fullscreen="true">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0 0 0</background_color>
        <camera_pose>24 -68 68 0 0.82 1.570796</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="GameModePlugin" name="Game Mode">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker Manager">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select Entities">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="Spawn" name="Spawn Entities">
        <gz-gui><property key="resizable" type="bool">false</property><property key="width" type="double">5</property><property key="height" type="double">5</property><property key="state" type="string">floating</property><property key="showTitleBar" type="bool">false</property></gz-gui>
      </plugin>
      <plugin filename="VisualizationCapabilities" name="Visualization Capabilities">
        <gz-gui>
          <title>Sensor Visualization</title>
          <property key="resizable" type="bool">true</property>
          <property key="width" type="double">260</property>
          <property key="height" type="double">220</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">true</property>
          <property key="z" type="double">3</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </gz-gui>
      </plugin>
      <plugin filename="Shapes" name="Shapes">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">300</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>
      <plugin filename="Lights" name="Lights">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">0</property>
          <property key="width" type="double">150</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#666666</property>
        </gz-gui>
      </plugin>
      <plugin filename="TransformControl" name="Transform control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">0</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">250</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="Screenshot" name="Screenshot">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">250</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">50</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="CopyPaste" name="CopyPaste">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="x" type="double">300</property>
          <property key="y" type="double">50</property>
          <property key="width" type="double">100</property>
          <property key="height" type="double">50</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
          <property key="cardBackground" type="string">#777777</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">160</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <use_event>true</use_event>
      </plugin>
    </gui>

    <!-- ═══ Physics ═══ -->
    <physics name="1ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ═══ Plugins ═══ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- ═══ Lights ═══ -->
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.4 -1.0</direction>
    </light>
    <light name="fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.4 -0.8</direction>
    </light>

    <!-- ═══ Ground Plane ═══ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <pose>24 16 0 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>120 120</size></plane>
          </geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.01 0 0 0</pose>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane><normal>0 0 1</normal><size>120 120</size></plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>model://caterpiller_cad/materials/textures/cad_floor_base.png</albedo_map>
              <metalness>0.0</metalness><roughness>1.0</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- CAD-specific charging area: three piles plus floor distance markers. -->
    <include>
      <uri>model://caterpiller_charging_area</uri>
      <name>caterpiller_charging_area</name>
      <pose>52.013097 7.913577 0 0 0 0</pose>
    </include>

    <!-- ═══ Origin reference ═══ -->
    <model name="origin_visual_axes">
      <static>true</static>
      <link name="x_axis">
        <pose>1 0 0.03 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>2 0.08 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="x_axis_arrow_upper">
        <pose>1.9 0.12 0.035 0 0 -0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="x_axis_arrow_lower">
        <pose>1.9 -0.12 0.035 0 0 0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.05 0.04 1</ambient>
            <diffuse>1.0 0.08 0.06 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis">
        <pose>0 1 0.035 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.08 2 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis_arrow_left">
        <pose>-0.12 1.9 0.04 0 0 0.785398</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="y_axis_arrow_right">
        <pose>0.12 1.9 0.04 0 0 2.356194</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.32 0.07 0.04</size></box></geometry>
          <material>
            <ambient>0.05 0.65 0.12 1</ambient>
            <diffuse>0.08 0.85 0.18 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="origin_disc">
        <pose>0 0 0.05 0 0 0</pose>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><cylinder><radius>0.22</radius><length>0.06</length></cylinder></geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Previous screenshot-based approximation retained below ground for comparison. -->
    <model name="navigation_test_arena_legacy_approximation">
      <static>true</static>
      <pose>0 0 -1000 0 0 0</pose>

      <!-- Outer building shell and major partition walls. -->
      <link name="outer_north_wall">
        <pose>-1.5 12 1 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>35 0.22 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <box><size>35 0.22 2</size></box>
          </geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="outer_south_wall">
        <pose>-2 -12 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>34 0.22 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>34 0.22 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="outer_west_wall">
        <pose>-19 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.22 24 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.22 24 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="outer_east_wall">
        <pose>19 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.22 24 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.22 24 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="warehouse_right_boundary_wall">
        <pose>9.25 -4.075 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.22 10.25 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.22 10.25 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="warehouse_right_jog_wall">
        <pose>11.125 1.05 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3.75 0.22 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>3.75 0.22 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="right_inner_connected_wall">
        <pose>13.0 -1.1 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.22 9.8 2</size></box></geometry></collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><box><size>0.22 9.8 2</size></box></geometry>
          <material>
            <ambient>0.78 0.82 0.86 1</ambient>
            <diffuse>0.82 0.86 0.90 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>

      <link name="central_horizontal_aisle_marker">
        <pose>-3 2.35 0.035 0 0 0</pose>
        <visual name="dash_01"><pose>-12 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_02"><pose>-10 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_03"><pose>-8 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_04"><pose>-6 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_05"><pose>-4 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_06"><pose>-2 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_07"><pose>0 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_08"><pose>2 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_09"><pose>4 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_10"><pose>6 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_11"><pose>8 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_12"><pose>10 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
        <visual name="dash_13"><pose>12 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
      </link>

      <link name="warehouse_south_aisle_marker">
        <pose>1 -9.2 0.035 0 0 0</pose>
        <visual name="dash_01"><pose>-8 0 0 0 0 0</pose><cast_shadows>false</cast_shadows><geometry><box><size>1.1 0.06 0.03</size></box></geometry><material><ambient>1.0 0.78 0.02 1</ambient><diffuse>1.0 0.86 0.08 1</diffuse><specular>0.02 0.02 0.02 1</specular></material></visual>
