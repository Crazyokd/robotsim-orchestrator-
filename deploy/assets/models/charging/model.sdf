<?xml version="1.0"?>
<sdf version="1.6">
  <model name="charging">
    <static>true</static>
    <link name="body">
      <!-- The supplied STL's charging face points along local -Y. EasyGo's
           dock pose convention expects the station face along model -X. -->
      <pose>0 0 0 0 0 -1.57079632679</pose>
      <!-- The source STL uses millimetres and spans z=-125..120. -->
      <visual name="visual">
        <pose>0 0 0.125 0 0 0</pose>
        <cast_shadows>true</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://charging/meshes/charging.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.58 0.62 1</ambient>
          <diffuse>0.65 0.68 0.72 1</diffuse>
          <specular>0.12 0.12 0.12 1</specular>
        </material>
      </visual>

      <!-- Keep the detailed V-panel geometry visible to simulated lidar. -->
      <collision name="collision">
        <pose>0 0 0.125 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://charging/meshes/charging.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>


      <!--
        Two 10 x 145 mm retroreflective strips, matching the real station.
        Their centers are 320 mm apart and their top edges align with the
        shifted STL top at z=0.245 m.  The supplied 0807 STL front face is at
        about y=-0.07495 m here; the 2 mm strip sits 0.05 mm ahead of it so
        the GPU lidar hits the retro surface without visible floating.
      -->
      <visual name="left_reflector_visual">
        <pose>-0.160 -0.076 0.1725 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <laser_retro>255</laser_retro>
        <geometry>
          <box>
            <size>0.010 0.002 0.145</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.90 1</ambient>
          <diffuse>1 1 0.95 1</diffuse>
          <specular>1 1 1 1</specular>
        </material>
      </visual>
      <collision name="left_reflector">
        <pose>-0.160 -0.076 0.1725 0 0 0</pose>
        <geometry>
          <box>
            <size>0.010 0.002 0.145</size>
          </box>
        </geometry>
      </collision>

      <visual name="right_reflector_visual">
        <pose>0.160 -0.076 0.1725 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <laser_retro>255</laser_retro>
        <geometry>
          <box>
            <size>0.010 0.002 0.145</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.90 1</ambient>
          <diffuse>1 1 0.95 1</diffuse>
          <specular>1 1 1 1</specular>
        </material>
      </visual>
      <collision name="right_reflector">
        <pose>0.160 -0.076 0.1725 0 0 0</pose>
        <geometry>
          <box>
            <size>0.010 0.002 0.145</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
