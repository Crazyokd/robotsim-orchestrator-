<?xml version="1.0"?>
<sdf version="1.6">
  <model name="caterpiller_cad">
    <static>true</static>
    <link name="factory_geometry">
      <collision name="cad_wall_collision">
        <geometry>
          <mesh>
            <uri>model://caterpiller_cad/meshes/cad_walls.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>100</mu><mu2>50</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="cad_wall_visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://caterpiller_cad/meshes/cad_walls.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.56 0.59 0.62 1</ambient>
          <diffuse>0.70 0.73 0.76 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
      <visual name="cad_floor_overlay">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://caterpiller_cad/meshes/cad_floor.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://caterpiller_cad/materials/textures/cad_floor.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
